# Copy to .env (gitignored) and replace every value. Secrets are read from the environment only (spec §16).
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GRADEMIND_JWT_SECRET=change-me-to-48-random-characters-change-me-to-48-random
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=grademind
MINIO_ROOT_PASSWORD=change-me-too
# first administrator (created once by the bootstrap service; ignored afterwards)
GRADEMIND_ADMIN_ORG=Demo College
GRADEMIND_ADMIN_EMAIL=admin@example.edu
GRADEMIND_ADMIN_PASSWORD=change-me-admin
# the host the browser uses to fetch signed image URLs
GRADEMIND_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
