# --- Student data (repo is PUBLIC). Owner decision D6/D15: only REDACTED data is committed. ---
# Unredacted originals: never committed (runs read these).
data/samples/
data/originals/
data/golden/
# Raw run dirs and preprocessing-variant images: local only (redacted text/JSON exports live in data/run_outputs/).
spike/runs/
spike/pages/
# Committed (redacted / verified): data/redacted/, data/run_outputs/, data/transcriptions/, data/fixtures/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Model weights / caches ---
models/
*.safetensors

# --- OCR service vendored dependencies (fetched by scripts/fetch_ocr_vendor.sh; release assets, not git) ---
services/ocr/vendor-cache/
services/ocr/wheelhouse/*
!services/ocr/wheelhouse/.gitkeep
!services/ocr/models/
services/ocr/models/*
!services/ocr/models/.gitkeep

# --- coverage data ---
.coverage
.coverage.*
htmlcov/

# --- exported labelled datasets (student handwriting; written by `cli export-corrections`) ---
datasets/

# --- backups (database dump + every stored object: student work; written by scripts/backup.sh) ---
backups/
